# =========================
# Application
# =========================

APP_NAME=Doctor Appointment API
API_PREFIX=/api
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:4002,http://127.0.0.1:4002

# =========================
# AI Runtime
# =========================

LLM_ENABLED=true
LLM_PROVIDER=claude
LLM_ALLOW_GENERATION=true

# Optional
LLM_SHADOW_MODE=false

# =========================
# Claude
# =========================

LLM_CLAUDE__ENABLED=true

LLM_CLAUDE__API_KEY=

LLM_CLAUDE__DEFAULT_MODEL_NAME=claude-haiku-4-5-20251001
LLM_ALLOW_REASONING=false

# Optional
LLM_CLAUDE__TIMEOUT_SECONDS=60
LLM_CLAUDE__MAX_RETRIES=2

# Default budget profile
LLM_GENERATION_BUDGET__DEFAULT_PROFILE=fast

# Fast profile
LLM_GENERATION_BUDGET__FAST__MAX_OUTPUT_TOKENS=256

# Claude override
LLM_CLAUDE__GENERATION_BUDGET__DEFAULT_PROFILE=fast

LLM_CLAUDE__GENERATION_BUDGET__FAST__MAX_OUTPUT_TOKENS=256

# LLM_GENERATION_BUDGET__DEFAULT_PROFILE=balanced

# LLM_GENERATION_BUDGET__FAST__MAX_OUTPUT_TOKENS=256
# LLM_GENERATION_BUDGET__BALANCED__MAX_OUTPUT_TOKENS=512
# LLM_GENERATION_BUDGET__WORKFLOW__MAX_OUTPUT_TOKENS=768
# LLM_GENERATION_BUDGET__QUALITY__MAX_OUTPUT_TOKENS=2048
# LLM_GENERATION_BUDGET__MAXIMUM__MAX_OUTPUT_TOKENS=4096

# LLM_CLAUDE__GENERATION_BUDGET__DEFAULT_PROFILE=balanced