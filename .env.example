# Core app configuration
APP_NAME=Doctor Appointment Testing App
API_PREFIX=/api
DATABASE_URL=sqlite:///./doctor_appointment.db
CORS_ORIGINS=http://localhost:4002,http://127.0.0.1:4002

# Inactive Phase 6.5/6.5.5 LLM configuration seam
# This configuration is intentionally not wired into runtime routing yet.
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_GENERATION_BUDGET__DEFAULT_PROFILE=balanced
LLM_GENERATION_BUDGET__FAST__MAX_OUTPUT_TOKENS=
LLM_GENERATION_BUDGET__BALANCED__MAX_OUTPUT_TOKENS=
LLM_GENERATION_BUDGET__WORKFLOW__MAX_OUTPUT_TOKENS=
LLM_GENERATION_BUDGET__QUALITY__MAX_OUTPUT_TOKENS=
LLM_GENERATION_BUDGET__MAXIMUM__MAX_OUTPUT_TOKENS=

# OpenAI
